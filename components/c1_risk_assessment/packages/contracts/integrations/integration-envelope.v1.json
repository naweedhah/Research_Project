{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnip.local/contracts/integrations/integration-envelope.v1.json",
  "title": "C1 Integration Envelope v1",
  "type": "object",
  "required": ["contract_version", "event_id", "correlation_id", "source_component", "event_type", "occurred_at", "payload"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "event_id": { "type": "string", "format": "uuid" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "source_component": { "type": "string", "enum": ["C1", "C2", "C3", "C4"] },
    "event_type": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string" },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
