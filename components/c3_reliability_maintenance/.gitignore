# Experiment outputs are aggregate numbers only (no child records), so they are tracked here even though the
# repository root ignores *.csv. Child-level data must never be placed in this folder.
!results/**/*.csv
!tests/fixtures/*.csv
!component3/context/data/*.csv

# Live service state (models, history, submitted batches): child-level, local only.
/state/

# Model files received from other components (e.g. C1 GA-RGCA bundle): not ours to publish.
/external_models/
