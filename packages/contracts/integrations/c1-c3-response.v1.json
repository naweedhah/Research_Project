{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnip.local/contracts/integrations/c1-c3-response.v1.json",
  "title": "C3→C1 Intervention Reassessment Response v1",
  "type": "object",
  "required": ["contract_version", "request_id", "status", "component"],
  "properties": {
    "contract_version": { "const": "1.0" },
    "request_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["QUEUED", "PROCESSING", "COMPLETED", "FAILED"] },
    "component": { "const": "C3" },
    "result_id": { "type": ["string", "null"] },
    "result_url": { "type": ["string", "null"] },
    "generated_at": { "type": ["string", "null"], "format": "date-time" },
    "message": { "type": ["string", "null"] }
  },
  "additionalProperties": true
}
